---
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
};

const { title, description = 'A static atlas of Chinese, Taiwanese, and Japanese teas — terroir, processing, and brewing as data.' } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,400;0,600;1,400&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('tea-atlas-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          Tea Atlas
          <small>leaves, water, time</small>
        </a>
        <nav class="primary" aria-label="Primary">
          <a href="/atlas" aria-current={isCurrent('/atlas') ? 'page' : undefined}>Atlas</a>
          <a href="/regions" aria-current={isCurrent('/regions') ? 'page' : undefined}>Regions</a>
          <a href="/brewing" aria-current={isCurrent('/brewing') ? 'page' : undefined}>Brewing</a>
          <a href="/glossary" aria-current={isCurrent('/glossary') ? 'page' : undefined}>Glossary</a>
          <button class="theme-toggle" type="button" data-theme-toggle>Theme</button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        Static site. No backend, no database — entries are typed content collections compiled to HTML.
      </div>
    </footer>
    <script>
      const btn = document.querySelector('[data-theme-toggle]');
      const root = document.documentElement;
      const label = () => {
        const current = root.getAttribute('data-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const dark = current ? current === 'dark' : prefersDark;
        if (btn) btn.textContent = dark ? 'Light' : 'Dark';
      };
      label();
      btn?.addEventListener('click', () => {
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.getAttribute('data-theme');
        const isDark = current ? current === 'dark' : prefersDark;
        const next = isDark ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('tea-atlas-theme', next);
        } catch (e) {}
        label();
      });
    </script>
  </body>
</html>
