---
import '../styles/global.css';
import { withBase } from '../lib/paths.js';

type Props = {
  title: string;
  description?: string;
  liquor?: string;
};

const {
  title,
  description = 'fourthsteep — a static atlas of Chinese, Taiwanese, and Japanese teas: terroir, processing, and brewing as data.',
  liquor,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  if (href === '/') return path === (base || '/');
  const target = `${base}${href}`;
  return path === target || path.startsWith(`${target}/`);
};
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" style={liquor}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('fourthsteep-theme') || localStorage.getItem('tea-atlas-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="rails" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={withBase('/')}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span>
            fourthsteep
            <small>steam · voltage · leaves</small>
          </span>
        </a>
        <nav class="primary" aria-label="Primary">
          <a href={withBase('/atlas')} aria-current={isCurrent('/atlas') ? 'page' : undefined}>Atlas</a>
          <a href={withBase('/regions')} aria-current={isCurrent('/regions') ? 'page' : undefined}>Regions</a>
          <a href={withBase('/brewing')} aria-current={isCurrent('/brewing') ? 'page' : undefined}>Brewing</a>
          <a href={withBase('/glossary')} aria-current={isCurrent('/glossary') ? 'page' : undefined}>Glossary</a>
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Dark theme">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <defs>
              <clipPath id="cup-clip">
                <path d="M5 9h11v5a5.5 5.5 0 0 1-11 0z"></path>
              </clipPath>
            </defs>
            <g class="toggle-steam">
              <path d="M9 6.2c0-1.3 1-1.7 1-3"></path>
              <path d="M12.6 6.2c0-1.3 1-1.7 1-3"></path>
            </g>
            <rect class="toggle-fill" x="4" y="8" width="13" height="12" clip-path="url(#cup-clip)"></rect>
            <g class="toggle-cup">
              <path d="M5 9h11v5a5.5 5.5 0 0 1-11 0z"></path>
              <path d="M16 10.6h1.2a2.4 2.4 0 0 1 0 4.8H16"></path>
              <path d="M4.2 21h12.6"></path>
            </g>
          </svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="ticker ticker--footer" aria-hidden="true">
        <div class="ticker__track">
          {
            {
              const terms = [
                '杀青',
                '焙火',
                '蒸し',
                '岩韵',
                '回甘',
                'gongfu',
                'grandpa',
                'kyusu',
                '渥堆',
                'no photographs',
                'the cup is the picture',
                'table = timer',
                '玉露',
                '大红袍',
                '第四泡',
              ];
              return [...terms, ...terms].map((term) => <span>{term}</span>);
            }
          }
        </div>
      </div>
      <div class="wrap">
        <div class="footer-wordmark" aria-hidden="true">fourthsteep</div>
      </div>
      <div class="footer-inner">
        <span>
          Static site — typed content collections compiled to HTML (<a href={withBase('/atlas.json')}>atlas.json</a>).
          No backend, no database.
        </span>
        <span>fourthsteep · {year}</span>
      </div>
    </footer>
    <script>
      import '../scripts/theme.js';
      import '../scripts/morph.js';
    </script>
  </body>
</html>
