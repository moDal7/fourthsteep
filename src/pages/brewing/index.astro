---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths.js';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const methods = guides.filter((g) => g.data.group === 'method');
const leaf = guides.filter((g) => g.data.group === 'leaf');
const knowledge = guides.filter((g) => g.data.group === 'knowledge');

function list(items, start) {
  return items.map((g, i) => ({ g, n: start + i }));
}
---

<Base title="Brewing · fourthsteep" description="Gongfu, western, Japanese, the leaf underneath, and the knowledge around them.">
  <div class="wrap" style="padding-top: 2.5rem; padding-bottom: 3rem">
    <p class="kicker">Guides</p>
    <h1>Brewing</h1>
    <p class="lede">
      Long-form MDX. Methods first, then the leaf, then water, ware, storage, and tasting. The timer on each tea page is
      the short version of the gongfu guide — rinses unnumbered, infusion 1 the first cup you drink. Two views are
      derived from the same records: the <a href={withBase('/brewing/matrix')}>method matrix</a> and
      <a href={withBase('/brewing/chains')}>processing chains</a>.
    </p>

    <div class="section-head">
      <h2>Methods</h2>
      <p class="meta">How to actually make the tea</p>
    </div>
    <ol class="rows numbered">
      {
        list(methods, 1).map(({ g, n }) => (
          <li>
            <a class="row" href={withBase(`/brewing/${g.id}`)}>
              <span class="row__n">{String(n).padStart(2, '0')}</span>
              <span class="row__body">
                <h3>{g.data.title}</h3>
                <p class="meta">{g.data.description}</p>
              </span>
              <span class="arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    {
      leaf.length > 0 && (
        <Fragment>
          <div class="section-head">
            <h2>Leaf</h2>
            <p class="meta">What the classes actually are</p>
          </div>
          <ol class="rows numbered">
            {list(leaf, methods.length + 1).map(({ g, n }) => (
              <li>
                <a class="row" href={withBase(`/brewing/${g.id}`)}>
                  <span class="row__n">{String(n).padStart(2, '0')}</span>
                  <span class="row__body">
                    <h3>{g.data.title}</h3>
                    <p class="meta">{g.data.description}</p>
                  </span>
                  <span class="arrow" aria-hidden="true">
                    &rarr;
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </Fragment>
      )
    }

    <div class="section-head">
      <h2>Knowledge</h2>
      <p class="meta">What sits underneath the methods</p>
    </div>
    <ol class="rows numbered">
      {
        list(knowledge, methods.length + leaf.length + 1).map(({ g, n }) => (
          <li>
            <a class="row" href={withBase(`/brewing/${g.id}`)}>
              <span class="row__n">{String(n).padStart(2, '0')}</span>
              <span class="row__body">
                <h3>{g.data.title}</h3>
                <p class="meta">{g.data.description}</p>
              </span>
              <span class="arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>
