---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const languages: Record<string, string> = { zh: 'Chinese', ja: 'Japanese', en: 'English' };

const terms = (await getCollection('glossary')).sort((a, b) => a.data.term.localeCompare(b.data.term));

const groups = terms.reduce((acc, term) => {
  const letter = term.data.term[0].toUpperCase();
  (acc[letter] ??= []).push(term);
  return acc;
}, {} as Record<string, typeof terms>);

const letters = Object.keys(groups).sort();
---

<Base title="Glossary · Tea Atlas" description="Bilingual tea vocabulary used in the atlas.">
  <div class="wrap" style="padding-top: 2.5rem; padding-bottom: 3rem">
    <p class="kicker">Vocabulary</p>
    <h1>Glossary</h1>
    <p class="lede">
      {terms.length} Chinese, Japanese, and English terms the entries assume you can look up — kill-green, roasting,
      steaming, and the words for what they leave in the cup.
    </p>

    <nav class="alpha-index" aria-label="Jump to letter">
      {letters.map((letter) => <a href={`#letter-${letter}`}>{letter}</a>)}
    </nav>

    <div class="glossary">
      {
        letters.map((letter) => (
          <section class="glossary-group" id={`letter-${letter}`} aria-labelledby={`heading-${letter}`}>
            <h2 class="glossary-letter" id={`heading-${letter}`}>
              {letter}
            </h2>
            <div class="glossary-entries">
              {groups[letter].map((t) => (
                <article class="glossary-item" id={t.id}>
                  <h3>
                    {t.data.term}
                    <span class="native">{t.data.native}</span>
                  </h3>
                  <p class="meta">
                    {t.data.romanization} · {languages[t.data.language] ?? t.data.language}
                  </p>
                  <p>{t.data.definition}</p>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>
