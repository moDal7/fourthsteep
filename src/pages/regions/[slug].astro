---
import Base from '../../layouts/Base.astro';
import TeaCard from '../../components/TeaCard.astro';
import { getCollection, render } from 'astro:content';
import { teasForRegion } from '../../lib/atlas.js';

export async function getStaticPaths() {
  const regions = await getCollection('regions');
  return regions.map((region) => ({ params: { slug: region.id }, props: { region } }));
}

const { region } = Astro.props;
const { Content } = await render(region);
const teas = teasForRegion(await getCollection('teas'), region.id).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<Base title={`${region.data.name} · fourthsteep`} description={region.data.summary}>
  <article class="wrap tea">
    <header class="tea-hero region-hero">
      <span class="tea-hero__watermark" aria-hidden="true">{region.data.nameNative}</span>
      <p class="kicker">{region.data.country} · terroir</p>
      <h1>{region.data.name}</h1>
      <p class="native tea-hero__native">{region.data.nameNative}</p>
      <p class="lede">{region.data.summary}</p>
      <dl class="deflist region-facts">
        <dt>Climate</dt>
        <dd>{region.data.climate}</dd>
        <dt>Known for</dt>
        <dd>
          <span class="cluster">
            {region.data.knownFor.map((k) => <span class="chip">{k}</span>)}
          </span>
        </dd>
      </dl>
    </header>

    <div class="prose">
      <Content />
    </div>

    <div class="section-head">
      <h2>Teas in this atlas</h2>
      {teas.length > 0 && <p class="meta">{teas.length} entries filed here</p>}
    </div>
    {
      teas.length ? (
        <div class="grid card-grid">
          {teas.map((t, i) => (
            <TeaCard
              id={t.id}
              index={i}
              name={t.data.name}
              nameNative={t.data.nameNative}
              country={t.data.origin.country}
              region={t.data.origin.region}
              category={t.data.category}
              oxidation={t.data.oxidation}
              roast={t.data.roast}
              summary={t.data.summary}
            />
          ))}
        </div>
      ) : (
        <p class="empty">No numbered entries are filed here yet — the page stands as map context.</p>
      )
    }
  </article>
</Base>
