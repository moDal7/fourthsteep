---
import { liquorStyle, transformationIndex, transformationKind } from '../lib/atlas.js';
import { withBase } from '../lib/paths.js';

interface Props {
  teas: { id: string; data: Record<string, any> }[];
  /** Slugs to name at rest, under their bars — identity without hover. */
  anchors?: string[];
}

const { teas, anchors = [] } = Astro.props;
const ordered = teas
  .slice()
  .sort(
    (a, b) =>
      transformationIndex(a.data) - transformationIndex(b.data) || a.data.name.localeCompare(b.data.name),
  );

const kindLabel = {
  none: 'untransformed',
  enzymatic: 'enzymatic oxidation',
  microbial: 'microbial',
  roast: 'roast',
};

const anchorLabels = ordered
  .map((tea, i) => ({ tea, x: ((i + 0.5) / ordered.length) * 100 }))
  .filter(({ tea }) => anchors.includes(tea.id))
  .map(({ tea, x }) => ({
    name: tea.data.name,
    x: x.toFixed(2),
    edge: x < 8 ? 'edge-start' : x > 92 ? 'edge-end' : null,
  }));
---

<section class="spectrum" aria-labelledby="spectrum-title">
  <div class="section-head">
    <h2 id="spectrum-title">The whole atlas, by transformation</h2>
    <p class="meta">
      Bar height is a transformation index, not one process. Hatch is microbial; dots are roast. Colour is still the
      cup — mixed from enzymatic oxidation, firing, and origin.
    </p>
  </div>

  <ol class="spectrum-strip" data-spectrum>
    {
      ordered.map((tea, i) => {
        const kind = transformationKind(tea.data);
        const index = transformationIndex(tea.data);
        return (
          <li
            class={kind === 'microbial' ? 'is-microbial' : kind === 'roast' ? 'is-roast' : undefined}
            style={`${liquorStyle({ ...tea.data, id: tea.id })}; --i: ${i}`}
          >
            <a href={withBase(`/tea/${tea.id}`)}>
              <span class={`spectrum-tick kind-${kind}`} style={`--h: ${28 + index * 0.72}%`} />
              <span class="sr-only">{tea.data.name}</span>
            </a>
            <span class="spectrum-read" aria-hidden="true">
              <b>{tea.data.name}</b>
              <span class="native">{tea.data.nameNative}</span>
              <span class="meta">
                {tea.data.origin.country} · {kindLabel[kind]} {index}
                {kind !== 'enzymatic' && kind !== 'none' ? ` · oxidation ${tea.data.oxidation}` : ''}
              </span>
            </span>
          </li>
        );
      })
    }
  </ol>

  {
    anchorLabels.length > 0 && (
      <div class="spectrum-anchors" aria-hidden="true">
        {anchorLabels.map((a) => (
          <span class={a.edge ?? undefined} style={`--x: ${a.x}%`}>
            {a.name}
          </span>
        ))}
      </div>
    )
  }

  <p class="spectrum-axis">
    <span>0 — none</span>
    <span class="spectrum-legend">
      <i class="legend-swatch legend-microbial" aria-hidden="true" /> microbial
      <i class="legend-swatch legend-roast" aria-hidden="true" /> roast
    </span>
    <span class="spectrum-hint spectrum-hint--fine">Hover a bar for the tea</span>
    <span class="spectrum-hint spectrum-hint--coarse">Tap a bar to name it; tap again to open</span>
    <span>100 — fully transformed</span>
  </p>
</section>

<script>
  const strip = document.querySelector('[data-spectrum]');
  if (strip && window.matchMedia('(pointer: coarse)').matches) {
    strip.addEventListener('click', (event) => {
      const target = event.target;
      const li = target instanceof Element ? target.closest('li') : null;
      if (!li || !strip.contains(li) || li.classList.contains('is-selected')) return;
      event.preventDefault();
      strip.querySelector('.is-selected')?.classList.remove('is-selected');
      li.classList.add('is-selected');
    });
  }
</script>
