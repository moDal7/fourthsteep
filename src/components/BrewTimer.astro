---
interface Infusion {
  n: number;
  seconds: number;
  notes?: string;
}

interface Props {
  infusions: Infusion[];
  caption: string;
}

const { infusions, caption } = Astro.props;
---

<section class="island timer" data-brew-timer aria-label="Brew timer">
  <div>
    <h2>Brew timer</h2>
    <p class="meta">{caption}</p>
  </div>
  <script type="application/json" set:html={JSON.stringify(infusions)} />

  <div class="timer-face">
    <div class="timer-ring">
      <svg class="timer-steam" viewBox="0 0 44 34" aria-hidden="true">
        <path d="M15 30c0-9 7-11 7-20" />
        <path d="M26 31c0-8 6-10 6-18" />
      </svg>
      <span class="timer-display" data-display>00:00</span>
    </div>
    <div class="timer-side">
      <p class="meta" data-meta></p>
      <ol class="pips" data-pips>
        {infusions.map((i) => <li aria-hidden="true"><span /></li>)}
      </ol>
      <p class="timer-note" data-notes></p>
    </div>
  </div>

  <p class="sr-only" data-live aria-live="polite"></p>

  <div class="controls">
    <button class="btn" type="button" data-start>Start</button>
    <button class="btn secondary" type="button" data-pause>Pause</button>
    <button class="btn secondary" type="button" data-next>Next steep</button>
    <button class="btn secondary" type="button" data-reset>Reset</button>
  </div>
  <p class="meta">The chime is a Web Audio oscillator — no audio file, no library.</p>
</section>
<script>
  import '../scripts/brew-timer.js';
</script>
