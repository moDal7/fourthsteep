---
interface Step {
  kind?: 'rinse' | 'steep';
  n?: number;
  seconds: number;
  notes?: string;
}

interface Props {
  steps: Step[];
  caption: string;
}

const { steps, caption } = Astro.props;
const longest = Math.max(...steps.map((i) => i.seconds), 1);
const format = (s: number) => (s >= 60 ? `${Math.floor(s / 60)}m ${s % 60 ? `${s % 60}s` : ''}`.trim() : `${s}s`);
---

<div class="table-wrap">
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Infusion</th>
        <th scope="col">Steep</th>
        <th scope="col">Notes</th>
      </tr>
    </thead>
    <tbody>
      {
        steps.map((row) => (
          <tr class={row.kind === 'rinse' ? 'is-rinse' : undefined}>
            <td class="num">{row.kind === 'rinse' ? 'rinse' : row.n}</td>
            <td>
              <span class="steep-cell">
                <span class="steep-bar" aria-hidden="true">
                  <span style={`--value: ${(row.seconds / longest) * 100}%`} />
                </span>
                <span class="num">{format(row.seconds)}</span>
              </span>
            </td>
            <td>{row.kind === 'rinse' ? `${row.notes ?? 'Discard'}` : (row.notes ?? '—')}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
