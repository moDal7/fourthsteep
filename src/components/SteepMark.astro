---
/** The hero mark: a leaf that draws itself, then steeps and gives off steam. */
---

<svg class="steep-mark" viewBox="0 0 220 220" role="img" aria-label="A tea leaf steeping">
  <g class="steep-mark__steam" aria-hidden="true">
    <path d="M104 40c0-16 13-20 13-36" />
    <path d="M126 46c0-13 11-17 11-30" />
    <path d="M82 50c0-13 11-17 11-30" />
  </g>
  <path class="steep-mark__blade" pathLength="1" d="M42 178C42 108 100 50 170 50c0 70-58 128-128 128Z" />
  <path class="steep-mark__vein" pathLength="1" d="M42 178C74 146 106 114 168 52" />
  <g class="steep-mark__ribs" aria-hidden="true">
    <path pathLength="1" d="M70 150c14-6 26-18 32-32" />
    <path pathLength="1" d="M96 124c14-6 26-18 32-32" />
    <path pathLength="1" d="M122 98c14-6 26-18 32-32" />
  </g>
</svg>
