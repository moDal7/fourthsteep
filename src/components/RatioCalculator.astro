---
interface Props {
  ratio: number;
  seedMl?: number;
}

const { ratio, seedMl = 120 } = Astro.props;
const seedG = (seedMl / ratio).toFixed(1);
---

<section class="island" data-ratio-calc data-ratio={String(ratio)} aria-label="Leaf ratio calculator">
  <div>
    <h2>Ratio calculator</h2>
    <p class="meta">Seeded from this tea’s gongfu ratio of 1:{ratio} — millilitres per gram.</p>
  </div>
  <div class="ratio-fields">
    <label class="field">
      Vessel (ml)
      <input data-volume type="number" min="20" step="10" value={String(seedMl)} />
    </label>
    <label class="field">
      Leaf (g)
      <input data-grams type="number" min="0.5" step="0.1" value={seedG} />
    </label>
  </div>
  <p class="ratio-out" data-out aria-live="polite"></p>
</section>
<script>
  import '../scripts/ratio-calc.js';
</script>
